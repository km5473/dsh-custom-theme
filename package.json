{
  "name": "dsh-customizable-theme",
  "version": "0.2.0",
  "description": "可自定义的 DSH 外观主题：壁纸、明暗两套 19 项配色、文案与六款表情，支持配置导入导出和 AI 生成配色（预填聊天框/补充指导/粘贴回复/提示词下载）；聊天框高斯模糊 + 高级模糊开关",
  "type": "module",
  "author": "km5473",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/km5473/dsh-customizable-theme.git" },
  "homepage": "https://github.com/km5473/dsh-customizable-theme#readme",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "src", "scripts", "tests", "assets", "cordis.patch.yml", "README.md", "LICENSE"],
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "public" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-theme", "@deepseek-ai/dsh-client-ui-settings-general", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/controller.test.mjs tests/plugin.smoke.mjs"
  }
}
